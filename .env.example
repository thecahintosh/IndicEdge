# Default deployment requires all three Supabase settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
PRUNE_API_KEY=
PRUNE_MODEL=
PORT=8787
INDICEDGE_HOST_PORT=8787
HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Explicit, localhost-only development; never enables remote AI calls.
LOCAL_MODE=false
DATA_DIR=.data
MAX_DAILY_CALLS=30
PRUNE_RUN_BUDGET_USD=0.02
